# Lido automaticamente pelo Cloudflare Pages
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Scripts do site: o navegador sempre confere se tem versão nova (temas, serviços etc.)
/assets/js/*
  Cache-Control: no-cache

# Plano da piscina: página pessoal, fora do Google
/piscina/*
  X-Robots-Tag: noindex, nofollow

# App instalável: o navegador sempre confere se o sw.js mudou
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
